{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChat",
  "version": "0.1.8",
  "identifier": "com.openchat.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "additionalWatchFolders": ["../frontend/dist"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenChat",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#F4F5F6",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-e7Q67myEm6+JiQEk8KL/hl+NWAJKx6n83mO0MvxFHms='; font-src 'self' data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "minimumWebview2Version": "111.0.1661.0",
      "nsis": {
        "headerImage": "../assets/brand/installer/header.bmp",
        "sidebarImage": "../assets/brand/installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/openchat-local-service"
    ]
  }
}
